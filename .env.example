# Google OAuth Configuration
# Client ID ends with .apps.googleusercontent.com (Web application type)
# Do NOT put the Client Secret (GOCSPX-...) in this file — secrets are not used in browser apps
VITE_GOOGLE_CLIENT_ID="288069059351-gdulgbc2tgd6g6d5po5cio09o3h4c486.apps.googleusercontent.com"
# Optional API key for Drive (starts with AIza...)
VITE_GOOGLE_API_KEY=

# Dropbox OAuth Configuration
VITE_DROPBOX_CLIENT_ID=your_dropbox_client_id_here

# OneDrive OAuth Configuration
VITE_ONEDRIVE_CLIENT_ID=your_onedrive_client_id_here

# Security Configuration
# Generate a strong random key for token encryption (e.g., using: openssl rand -base64 32)
VITE_ENCRYPTION_KEY="HbrCJ712CUiEALHT32dWuYRgUPGen/Usk8q7r44Bjx4="